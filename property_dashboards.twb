    <worksheet name='Chart 3 — Filled Map (Value Score)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#e4ff30' fontsize='18'>Which Planning Areas Offer The Best Value For Money?</run>
