          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Min. Schools Nearby' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <range granularity='1' max='5' min='0' />
            </column>
            <column caption='Travel Mode' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Public Transport&quot;'>
              <calculation class='tableau' formula='&quot;Public Transport&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q84nl109sxkft18igaiv0syhhrs'>
            <column caption='Accessibility Score' datatype='real' name='[AccessibilityScore]' role='measure' type='quantitative' />
            <column caption='Schools Near Property ' datatype='string' name='[Calculation_1058832002998273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [NumberofSchoolsWithin500Mts] &gt;= [Parameters].[Parameter 1]&#13;&#10;THEN &quot;Meets Requirement&quot;&#13;&#10;ELSE &quot;Below Requirement&quot;&#13;&#10;END' />
            </column>
            <column caption='Commute Category to City' datatype='string' name='[Calculation_3161926376439808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Car&quot; &#13;&#10;THEN [CityProximityCategory_Car]&#13;&#10;ELSE [CityProximityCategory_PT]&#13;&#10;END' />
            </column>
            <column caption='Value Score' datatype='real' name='[Calculation_3161926380855297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([AccessibilityScore]) / AVG([TransactedPricePerSqFt]) * 1000' />
            </column>
            <column caption='Commute to City (Selection Mode)' datatype='real' name='[Calculation_3161926394167298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Car&quot; &#13;&#10;THEN [TimeToRafflesInMins_Car]&#13;&#10;ELSE [TimeToRafflesInMins_PT]&#13;&#10;END' />
            </column>
            <column caption='CityProximityCategory Car' datatype='string' name='[CityProximityCategory_Car]' role='dimension' type='nominal' />
            <column caption='CityProximityCategory PT' datatype='string' name='[CityProximityCategory_PT]' role='dimension' type='nominal' />
            <column datatype='real' name='[NumberofSchoolsWithin500Mts]' role='measure' type='quantitative' />
            <column caption='Planning Area Name' datatype='string' name='[PlanningAreaName]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Property Category' datatype='string' name='[PropertyCategory]' role='dimension' type='nominal' />
