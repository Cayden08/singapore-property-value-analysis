                <story-points>
                  <story-point caption='Singapore property prices rose significantly from 2006–2015, with Private and Landed properties showing the steepest growth' captured-sheet='Chart 1 — Line Chart' id='1' />
                  <story-point caption='Not all expensive areas offer the best value — heartland planning areas score surprisingly well on accessibility per dollar.' captured-sheet='Chart 3 — Filled Map (Value Score)' id='2'>
                    <capturedDeltas>
                      <worksheet name='Chart 3 — Filled Map (Value Score)'>
